{
  "info": {
    "name": "CollectIQ AI",
    "description": "AI invoice collection agent on PayPal Invoicing (Sandbox). Set `baseUrl` to the live demo or http://localhost:8000. Write requests (Approve, Execute, Run autopilot with auto-approve) act on PayPal Sandbox only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://collectiq-ai-dlxu.onrender.com"
    },
    {
      "key": "actionId",
      "value": ""
    },
    {
      "key": "parametersHash",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Status",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PayPal connection status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/integrations/paypal/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "integrations",
                "paypal",
                "status"
              ]
            },
            "description": "Checks OAuth against PayPal Sandbox."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('PayPal connected', () => pm.expect(pm.response.json().connected).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Invoices and insights",
      "item": [
        {
          "name": "Invoice analysis",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/analysis",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "analysis"
              ]
            },
            "description": "Live PayPal invoices with deterministic collection state, priority and the allowed action."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Client insights and 30-day forecast",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/insights",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "insights"
              ]
            },
            "description": "Per-client payment behaviour from PayPal payment history and expected collections."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. AI agent",
      "item": [
        {
          "name": "Ask the collection agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agent/runs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agent",
                "runs"
              ]
            },
            "description": "Runs the Gemini agent with allowlisted tools. Proposals are stored for approval, never executed here.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Which clients usually pay late, and how much can I expect to collect in the next 30 days?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has a summary', () => pm.expect(pm.response.json().summary).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Approvals",
      "item": [
        {
          "name": "List pending actions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/actions?approval_status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "actions"
              ],
              "query": [
                {
                  "key": "approval_status",
                  "value": "pending"
                }
              ]
            },
            "description": "Stores the first pending action's id and parameters_hash in collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items || [];",
                  "if (items.length) {",
                  "  pm.collectionVariables.set('actionId', items[0].id);",
                  "  pm.collectionVariables.set('parametersHash', items[0].parameters_hash);",
                  "}",
                  "pm.test('Pending actions listed', () => pm.expect(items).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get action",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/actions/{{actionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "actions",
                "{{actionId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve action (hash-bound)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/actions/{{actionId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "actions",
                "{{actionId}}",
                "approve"
              ]
            },
            "description": "Approval is bound to the SHA-256 hash of the exact parameters.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parameters_hash\": \"{{parametersHash}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Execute approved action (PayPal Sandbox write)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/actions/{{actionId}}/execute",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "actions",
                "{{actionId}}",
                "execute"
              ]
            },
            "description": "Re-checks the invoice in PayPal, executes once with a PayPal-Request-Id and verifies the result."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/actions/{{actionId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "actions",
                "{{actionId}}",
                "reject"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Not now\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Autopilot",
      "item": [
        {
          "name": "Autopilot settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/autopilot/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "autopilot",
                "settings"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Run autopilot now",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/autopilot/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "autopilot",
                "run"
              ]
            },
            "description": "Runs the deterministic playbook. Proposals wait for approval unless the strict auto-approve policy is enabled."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Safety",
      "item": [
        {
          "name": "Safety report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/safety",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "safety"
              ]
            },
            "description": "Guardrails and live evidence from the audit trail."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('No PayPal write without approval', () => pm.expect(pm.response.json().counts.executions_without_approval).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check a message (payment redirection)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/safety/check-message",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "safety",
                "check-message"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hi Sam, our bank details changed. Please wire the payment to IBAN DE00 1234 5678 instead.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Unsafe message is blocked', () => pm.expect(pm.response.json().passed).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Audit",
      "item": [
        {
          "name": "Audit trail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audit?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "audit"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}