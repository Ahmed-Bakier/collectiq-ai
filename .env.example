# =====================================================
# CollectIQ AI - Environment Variables Template
# Copy this file to backend/.env and fill in real values.
# NEVER commit real credentials.
# =====================================================

# --- Application ---
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
BUSINESS_TIMEZONE=America/Los_Angeles

# --- Database ---
DATABASE_URL=sqlite:///./collectiq.db

# --- PayPal (Sandbox only) ---
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_SANDBOX_INVOICER_EMAIL=your-sandbox-business-email@business.example.com

# --- AI Provider (OpenAI-compatible API; default: Google Gemini free tier) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=your-llm-api-key
LLM_REASONING_EFFORT=low

# --- Autopilot ---
# Run the collection playbook every N minutes (0 = disabled; use "Run now" in the app).
AUTOPILOT_INTERVAL_MINUTES=0

# --- Reliability & deployment ---
# Optional fallback model on the same provider (used once on rate limits / provider errors).
LLM_FALLBACK_MODEL=
# Max AI requests per visitor IP per hour (0 = unlimited; use 20-30 on a public demo).
AI_RATE_LIMIT_PER_HOUR=0
# Path to the built frontend (set automatically in Docker; leave empty for local development).
FRONTEND_DIST_DIR=
